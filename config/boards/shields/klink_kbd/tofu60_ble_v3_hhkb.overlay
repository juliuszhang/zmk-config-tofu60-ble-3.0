/*
 * Reuse the vendor-tested ANSI 7U matrix and its complete position map.
 * layout3 provides the split Backspace row and 1.75U right Shift used by
 * this HHKB keymap. The two unused outer bottom-row positions are disabled
 * in tofu60_ble_v3_hhkb.keymap.
 */
#include "tofu60_ble_v3_ansi_7u.overlay"

/ {
    chosen {
        zmk,physical-layout = &layout3;
    };
};
